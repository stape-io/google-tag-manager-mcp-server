/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "google-tag-manager-mcp-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "gtm-mcp.stape.ai",
      "custom_domain": true
    }
  ],
  "migrations": [
    {
      "new_sqlite_classes": [
        "GoogleTagManagerMCPServer"
      ],
      "tag": "v1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "GoogleTagManagerMCPServer",
        "name": "MCP_OBJECT"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "a2bbe0a0645e44bf83b5dc450d8a9496"
    }
  ],
  "observability": {
    "enabled": false
  },
  "dev": {
    "port": 8788
  },

  // Bindings are not inherited by named environments, so each env restates its
  // own Durable Object and KV namespace. Everything else falls through from above.
  "env": {
    "dev": {
      "name": "google-tag-manager-mcp-server-dev",
      "routes": [
        {
          "pattern": "gtm-mcp.stape.dev",
          "custom_domain": true
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "class_name": "GoogleTagManagerMCPServer",
            "name": "MCP_OBJECT"
          }
        ]
      },
      "kv_namespaces": [
        {
          "binding": "OAUTH_KV",
          "id": "49a584d999764898b6b2f9b5673013be"
        }
      ]
    },
    // Production on gtm-mcp.stape.io, in the Cloudflare account that owns the
    // stape.io zone. The KV namespace is managed in the terraform repo:
    // gcp/stape-production/google-tag-manager-mcp-server (oauth_io).
    "io": {
      "name": "google-tag-manager-mcp-server",
      // The custom domain creates the DNS record and certificate. The route is
      // needed because the stape.io zone has a catch-all `*/*` route to
      // gtm-loader that runs before a custom-domain Worker and 301s unknown
      // hosts to stape.io; this more specific route sends the host here instead.
      "routes": [
        {
          "pattern": "gtm-mcp.stape.io",
          "custom_domain": true
        },
        {
          "pattern": "gtm-mcp.stape.io/*",
          "zone_name": "stape.io"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "class_name": "GoogleTagManagerMCPServer",
            "name": "MCP_OBJECT"
          }
        ]
      },
      "kv_namespaces": [
        {
          "binding": "OAUTH_KV",
          "id": "6aefe0e3c5cd414691960b6bfa44469e"
        }
      ]
    }
  }
}
